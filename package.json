{
  "name": "stralforsmcp",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && sh scripts/setup-hooks.sh || true",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "node --watch --env-file=.env.local src/server/main.ts",
    "dev:debug": "node --watch --inspect --env-file=.env.local src/server/main.ts",
    "dev:debug:brk": "node --watch --inspect-brk --env-file=.env.local src/server/main.ts",
    "dev:token": "node --env-file=.env.local scripts/dev-token.ts",
    "mcpb:build": "node scripts/build-mcpb.ts",
    "live:channels": "node scripts/live-channels.ts",
    "check": "npm run lint && npm run typecheck && vitest run --coverage",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-prometheus": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "pino": "10.4.0",
    "undici": "8.12.4",
    "zod": "4.6.7"
  }
}
