# Local TEST run. Copy to .env.local (git-ignored), edit the paths, then `npm run dev`.
# Placeholders only: secrets are FILE PATHS, never values. Never commit .env.local.

# Deployment environment; local work is always test.
STRALFORS_ENV=test

# Credential profile id(s), comma-separated. <ID> below is the id in upper case, '-' as '_'.
STRALFORS_PROFILES=dev
STRALFORS_PROFILE_DEV_COUNTRY=SE
# Files holding the TEST client id, client secret, mTLS certificate and key (paths, readable by you).
STRALFORS_PROFILE_DEV_CLIENT_ID_FILE=/path/to/client-id
STRALFORS_PROFILE_DEV_CLIENT_SECRET_FILE=/path/to/client-secret
STRALFORS_PROFILE_DEV_CERT_FILE=/path/to/client.pem
STRALFORS_PROFILE_DEV_KEY_FILE=/path/to/client.key

# Token list written by `npm run dev:token` (hashes only).
MCP_TOKEN_LIST_FILE=./token-list.json

# Allowed Host header hostnames (no scheme, no port).
MCP_HOSTNAMES=localhost

# Optional: change the ports (defaults 3000 MCP, 9464 metrics).
# MCP_PORT=3000
# MCP_METRICS_PORT=9464

# trace | debug | info | warn | error | fatal | silent (default info). Logs go to stderr.
MCP_LOG_LEVEL=debug

# Fast restarts under `node --watch`: otherwise the old process keeps the ports during the drain.
MCP_DRAIN_MS=0
